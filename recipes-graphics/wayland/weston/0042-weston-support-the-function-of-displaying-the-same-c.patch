 	/* Make sure the scale is set up */
 	assert(output->scale);
@@ -8459,7 +8464,7 @@ static void weston_compositor_print_scene(struct weston_compositor *ec, FILE *fp
 		struct weston_head *head;
 		int head_idx = 0;
 
-		fprintf(fp, "Output %d (%s):\n", output->id, output->name);
