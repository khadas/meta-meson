--- a/libweston/backend-drm/drm.c
+++ b/libweston/backend-drm/drm.c
@@ -65,6 +65,7 @@
 #include "linux-dmabuf.h"
 #include "linux-dmabuf-unstable-v1-server-protocol.h"
 #include "linux-explicit-synchronization.h"
